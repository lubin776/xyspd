<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>网盘资源搜索</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 20px; }
        .container { max-width: 1000px; margin: 0 auto; }
        
        .header { text-align: center; margin-bottom: 40px; }
        .header h1 { color: #fff; font-size: 36px; margin-bottom: 10px; text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
        .header p { color: rgba(255,255,255,0.9); font-size: 16px; }
        
        .search-box { background: #fff; padding: 30px; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); margin-bottom: 30px; }
        .search-form { display: flex; gap: 15px; }
        .search-form input { flex: 1; padding: 15px 20px; border: 2px solid #e8e8e8; border-radius: 10px; font-size: 16px; transition: all 0.3s; }
        .search-form input:focus { outline: none; border-color: #667eea; }
        .search-form button { padding: 15px 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; border-radius: 10px; font-size: 16px; cursor: pointer; transition: all 0.3s; }
        .search-form button:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4); }
        
        .results { background: #fff; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); overflow: hidden; }
        .result-item { padding: 20px; border-bottom: 1px solid #f0f0f0; transition: background 0.2s; }
        .result-item:hover { background: #fafafa; }
        .result-item:last-child { border-bottom: none; }
        
        .result-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .result-name { font-size: 18px; color: #333; font-weight: 500; }
        .result-type { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .result-type.QUARK { background: #e6f7ff; color: #1890ff; }
        .result-type.BDY { background: #fff7e6; color: #fa8c16; }
        .result-type.UC { background: #f6ffed; color: #52c41a; }
        .result-type.GUANGYA { background: #fffbe6; color: #d4b106; }
        
        .result-meta { display: flex; gap: 20px; color: #999; font-size: 14px; margin-bottom: 10px; }
        .result-meta span { display: flex; align-items: center; gap: 5px; }
        
        .result-link { display: inline-block; padding: 8px 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; text-decoration: none; border-radius: 20px; font-size: 14px; transition: all 0.3s; }
        .result-link:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4); }
        
        .empty { text-align: center; padding: 60px 20px; color: #999; }
        .loading { text-align: center; padding: 40px; color: #999; }
        
        .load-more { text-align: center; padding: 20px; }
        .load-more button { padding: 12px 40px; background: #f5f5f5; border: none; border-radius: 20px; color: #666; cursor: pointer; transition: all 0.3s; }
        .load-more button:hover { background: #e8e8e8; }
        
        .footer { text-align: center; margin-top: 40px; color: rgba(255,255,255,0.8); font-size: 14px; }
        .footer a { color: #fff; text-decoration: none; margin: 0 10px; }
        .footer a:hover { text-decoration: underline; }
        
        .admin-link { position: fixed; top: 20px; right: 20px; padding: 10px 20px; background: rgba(255,255,255,0.2); color: #fff; text-decoration: none; border-radius: 20px; font-size: 14px; transition: all 0.3s; backdrop-filter: blur(10px); }
        .admin-link:hover { background: rgba(255,255,255,0.3); }
        
        .result-name-link { font-size: 18px; color: #333; font-weight: 500; text-decoration: none; transition: color 0.2s; }
        .result-name-link:hover { color: #667eea; text-decoration: underline; }
    </style>
</head>
<body>
    <a href="/admin" class="admin-link">🔐 管理后台</a>
    
    <div class="container">
        <div class="header">
            <h1>🎬 网盘资源搜索</h1>
            <p>搜索夸克、百度、UC、光鸭网盘分享资源</p>
        </div>
        
        <div class="search-box">
            <form class="search-form" onsubmit="search(event)">
                <input type="text" id="keyword" placeholder="输入关键词搜索资源..." autocomplete="off">
                <button type="submit">搜索</button>
            </form>
        </div>
        
        <div class="results" id="results">
            <div class="empty">输入关键词开始搜索</div>
        </div>
        
        <div class="footer">
            <a href="/">首页</a>
            
        </div>
    </div>

    <script>
        let lastWeight = 0;
        let lastId = 0;
        let hasMore = true;
        let currentKeyword = '';
        
        async function search(e) {
            if (e) e.preventDefault();
            const keyword = document.getElementById('keyword').value.trim();
            if (!keyword) return;
            
            currentKeyword = keyword;
            lastWeight = 0;
            lastId = 0;
            hasMore = true;
            
            document.getElementById('results').innerHTML = '<div class="loading">搜索中...</div>';
            
            try {
                const res = await fetch(`/api/disks/search?keyword=${encodeURIComponent(keyword)}&last_weight=0&last_id=0`);
                const data = await res.json();
                
                if (data.data && data.data.length > 0) {
                    renderResults(data.data, true);
                    if (data.data.length < 20) hasMore = false;
                } else {
                    document.getElementById('results').innerHTML = '<div class="empty">未找到相关资源</div>';
                    hasMore = false;
                }
            } catch (err) {
                document.getElementById('results').innerHTML = '<div class="empty">搜索失败，请稍后重试</div>';
            }
        }
        
        async function loadMore() {
            if (!hasMore) return;
            
            try {
                const res = await fetch(`/api/disks?keyword=${encodeURIComponent(currentKeyword)}&last_weight=${lastWeight}&last_id=${lastId}`);
                const data = await res.json();
                
                if (data.data && data.data.length > 0) {
                    renderResults(data.data, false);
                    if (data.data.length < 20) hasMore = false;
                } else {
                    hasMore = false;
                    document.querySelector('.load-more')?.remove();
                }
            } catch (err) {
                console.error('加载更多失败', err);
            }
        }
        
        function renderResults(items, clear = true) {
            const container = document.getElementById('results');
            
            if (clear) {
                container.innerHTML = '';
            } else {
                document.querySelector('.load-more')?.remove();
            }
            
            items.forEach(item => {
                const div = document.createElement('div');
                div.className = 'result-item';
                div.innerHTML = `
                    <div class="result-header">
                        <a href="${item.disk_url}" target="_blank" rel="noreferrer" class="result-name-link">${escapeHtml(item.disk_name)}</a>
                        <span class="result-type ${item.disk_type}">${item.disk_type}</span>
                    </div>
                    <div class="result-meta">
                        <span>👤 ${escapeHtml(item.share_user || '未知')}</span>
                        <span>🔥 热度: ${item.weight}</span>
                    </div>
                    <a href="${item.disk_url}" target="_blank" rel="noreferrer" class="result-link">打开网盘</a>
                `;
                container.appendChild(div);
                
                lastWeight = item.weight;
                lastId = item.id;
            });
            
            if (hasMore && items.length === 20) {
                const loadMoreDiv = document.createElement('div');
                loadMoreDiv.className = 'load-more';
                loadMoreDiv.innerHTML = '<button onclick="loadMore()">加载更多</button>';
                container.appendChild(loadMoreDiv);
            }
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        document.getElementById('keyword').addEventListener('keypress', e => {
            if (e.key === 'Enter') search(e);
        });
    </script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v3d52b47920f24c319d37e2661827c42b1787588026925" integrity="sha512-d9sL6GJLXn6fInD1+TVXhTcQOsmxeHfmHAvwGDIxp5TO+uo1fiWW7mHomMj4MLRlCsJDTqXzWLHJFFlPCEIj/A==" data-cf-beacon='{"version":"2024.11.0","token":"26de6679d36d4eb6ba46ba04cac3dac5","r":1}' crossorigin="anonymous"></script>
</body>
</html>
